<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="smile_retailer_service" resource="default" engine="innodb" comment="smile_retailer_service">
        <column xsi:type="int" name="service_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Name"/>
        <column xsi:type="text" name="description" nullable="true" comment="Description"/>
        <column xsi:type="smallint" name="status" unsigned="true" nullable="false" identity="false" default="0" comment="Status"/>
        <column xsi:type="varchar" name="media_path" nullable="true" length="255" comment="Media file path"/>
        <column xsi:type="int" name="retailer_id" unsigned="true" nullable="false" identity="false" comment="Retailer ID"/>
        <column xsi:type="int" name="sort" unsigned="true" nullable="true" identity="false" comment="Sort"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="true" comment="Creation Time"/>
        <column xsi:type="timestamp" name="end_at" on_update="false" nullable="true" comment="End at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="service_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="SMILE_RETAILER_SERVICE_RETAILER_ID_SMILE_SELLER_ENTITY_ENTITY_ID"
                    table="smile_retailer_service" column="retailer_id"
                    referenceTable="smile_seller_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>
</schema>
